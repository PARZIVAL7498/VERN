TENSORMUX_API_KEY=
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_MODEL=glm-4-7-flash
VERN_DATA_DIR=./data
# LLM writes every reply from memory+tool facts (set 0 for template-only)
VERN_LLM_REPLY=1
VERN_LLM_TIMEOUT_MS=12000
# Learn CEO thinking style from chat (set 0 to disable)
VERN_LEARN=1
VERN_LEARN_EVERY_N=3
VERN_LEARN_TIMEOUT_MS=10000
